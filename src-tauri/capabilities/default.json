{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Permissions for the main workbench window. Grant only what the workbench uses.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "allow-app-info",
    "allow-document-list",
    "allow-document-state",
    "allow-document-apply",
    "allow-document-undo",
    "allow-document-redo",
    "allow-typesetting-watch",
    "allow-typesetting-unwatch",
    "allow-typesetting-build",
    "allow-typesetting-page-svg",
    "allow-typesetting-export-pdf",
    "allow-page-hit-test",
    "allow-page-caret",
    "allow-page-navigate",
    "allow-page-selection",
    "allow-page-edit"
  ]
}
