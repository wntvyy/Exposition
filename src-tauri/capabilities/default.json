{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Permissions for the main workbench window. Grant only what the workbench uses.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "allow-app-info",
    "allow-document-list",
    "allow-document-state",
    "allow-document-apply",
    "allow-document-undo",
    "allow-document-redo",
    "allow-workspace-open",
    "allow-workspace-close",
    "allow-workspace-current",
    "allow-workspace-recent",
    "allow-workspace-forget-recent",
    "allow-workspace-list-dir",
    "allow-document-open",
    "allow-document-close",
    "allow-document-save",
    "allow-document-save-all",
    "allow-document-reload",
    "allow-document-keep-buffer",
    "allow-document-normalize-line-endings",
    "allow-recovery-list",
    "allow-recovery-restore",
    "allow-recovery-discard",
    "allow-settings-get",
    "allow-settings-update",
    "allow-project-settings-get",
    "allow-project-settings-update",
    "allow-job-list",
    "allow-job-output",
    "allow-job-cancel",
    "allow-toolchains-list",
    "allow-toolchains-refresh",
    "allow-trust-status",
    "allow-trust-grant",
    "allow-trust-revoke",
    "allow-tex-build",
    "allow-tex-status",
    "allow-tex-cancel",
    "allow-tex-page-image",
    "allow-tex-page-map",
    "allow-agents-provider-status",
    "allow-agents-provider-update",
    "allow-agents-provider-set-key",
    "allow-agents-provider-clear-key",
    "allow-agents-task-list",
    "allow-agents-task-detail",
    "allow-agents-task-create",
    "allow-agents-task-continue",
    "allow-agents-task-cancel",
    "allow-agents-approval-resolve",
    "allow-agents-review",
    "allow-agents-review-diff",
    "allow-agents-review-revert",
    "allow-agents-review-accept"
  ]
}
