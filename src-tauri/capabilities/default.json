{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Permissions for the main workbench window. Grant only what the workbench uses.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "allow-app-info",
    "allow-document-list",
    "allow-document-state",
    "allow-document-apply",
    "allow-document-undo",
    "allow-document-redo",
    "allow-job-list",
    "allow-job-output",
    "allow-job-cancel",
    "allow-toolchains-list",
    "allow-toolchains-refresh",
    "allow-trust-status",
    "allow-trust-grant",
    "allow-trust-revoke",
    "allow-agents-provider-status",
    "allow-agents-provider-update",
    "allow-agents-provider-set-key",
    "allow-agents-provider-clear-key",
    "allow-agents-task-list",
    "allow-agents-task-detail",
    "allow-agents-task-create",
    "allow-agents-task-continue",
    "allow-agents-task-cancel",
    "allow-agents-approval-resolve",
    "allow-agents-review",
    "allow-agents-review-diff",
    "allow-agents-review-revert",
    "allow-agents-review-accept"
  ]
}
